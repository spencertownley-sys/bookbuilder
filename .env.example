# Copy to .env.local and fill in. Never commit .env.local.

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Clerk (login) — dashboard.clerk.com → your app → API keys ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard
# Webhooks → add endpoint https://YOUR_DOMAIN/api/webhooks/clerk with event user.deleted, paste its signing secret:
CLERK_WEBHOOK_SIGNING_SECRET=

# --- Database (any Postgres) ---
# Local: `npm run db` starts one on this URL. Supabase: Project → Connect → "Transaction pooler" URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_POOL_SIZE=1

# --- File storage (images, voice recordings, print PDFs) ---
# Leave blank locally (files go to .data/files). In production use Supabase Storage:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=media

# --- Stripe (payments) — dashboard.stripe.com → Developers ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_AUTOMATIC_TAX=false
STRIPE_PRICE_CREATOR_MONTHLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_YEARLY=
STRIPE_PRICE_AI_PACK=
STRIPE_PRICE_KEEPSAKE=
# Local testing without Stripe: unlocks and print orders succeed instantly (ignored in production
# and whenever STRIPE_SECRET_KEY is set).
DEV_FAKE_PAYMENTS=1

# --- AI illustrations: "fal" (cheapest) or "openai" ---
AI_IMAGE_PROVIDER=fal
FAL_KEY=
OPENAI_API_KEY=

# --- Lulu Print API (printed copies) — developers.sandbox.lulu.com for testing ---
LULU_API_BASE=https://api.sandbox.lulu.com
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=

# --- Support + admin ---
# Shown on the legal pages and in the footer.
NEXT_PUBLIC_SUPPORT_EMAIL=
# Who can open /admin (launch metrics + reports): Clerk user ids and/or emails, comma-separated.
ADMIN_USER_IDS=
ADMIN_EMAILS=
